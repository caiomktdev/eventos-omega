# =============================================================================
# EventosOmega — Produção (Hostinger VPS)
# Copie para .env.production no servidor e preencha os valores reais.
# =============================================================================

# Banco PostgreSQL local na VPS
DATABASE_URL="postgresql://eventos_app:CHANGE_ME@127.0.0.1:5432/eventos_omega?schema=public"
DIRECT_URL="postgresql://eventos_app:CHANGE_ME@127.0.0.1:5432/eventos_omega?schema=public"

# Auth.js
AUTH_SECRET="CHANGE_ME_WITH_A_STRONG_SECRET"

# URL pública da aplicação
NEXT_PUBLIC_APP_URL="https://eventosomega.com.br"

# Mercado Pago (conta da plataforma marketplace)
MERCADOPAGO_ACCESS_TOKEN="APP_USR-..."
MERCADOPAGO_CLIENT_ID="..."
MERCADOPAGO_CLIENT_SECRET="..."
MERCADOPAGO_WEBHOOK_SECRET="..."
NEXT_PUBLIC_MERCADOPAGO_PUBLIC_KEY="APP_USR-..."

# E-mail transacional (Resend)
RESEND_API_KEY="re_..."
EMAIL_FROM="EventosOmega <ingressos@eventosomega.com.br>"

# Segurança de cron interno
CRON_SECRET="CHANGE_ME_WITH_A_STRONG_SECRET"

# Opcional: rate limit distribuído com Upstash
# UPSTASH_REDIS_REST_URL="https://..."
# UPSTASH_REDIS_REST_TOKEN="..."
