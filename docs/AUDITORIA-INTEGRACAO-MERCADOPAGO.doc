<table>
<tr><th>Arquivo</th><th>Responsabilidade</th></tr>
<tr><td>src/lib/fee.ts</td><td>Cálculo 5,5% — fonte única</td></tr>
<tr><td>src/lib/mercadopago.ts</td><td>SDK MP (plataforma + token organizador)</td></tr>
